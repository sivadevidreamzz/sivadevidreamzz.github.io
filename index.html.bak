  <!-- ================= BOOKING MODAL ================= -->
  <div class="modal-overlay" id="bookingOverlay">
    <div class="modal">
      <button class="modal-close" id="modalClose" aria-label="Close">&times;</button>

      <div class="modal-form-wrap" id="formWrap">
        <p class="eyebrow">Book Your Slot</p>
        <h3>Let's Plan Your Shoot</h3>
        <form id="bookingForm">
          <div class="field">
            <label for="fName">Full Name *</label>
            <input type="text" id="fName" required placeholder="e.g. Priya Karthik">
          </div>
          <div class="field">
            <label for="fPhone">Phone / WhatsApp Number *</label>
            <input type="tel" id="fPhone" required placeholder="10-digit mobile number" pattern="[0-9]{10}">
          </div>
          <div class="field-row">
            <div class="field">
              <label for="fDate">Preferred Date *</label>
              <input type="date" id="fDate" required>
            </div>
            <div class="field">
              <label for="fSlot">Time Slot *</label>
              <select id="fSlot" required>
                <option value="">Choose</option>
                <option>Morning</option>
                <option>Afternoon</option>
                <option>Evening</option>
              </select>
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="fType">Shoot Type *</label>
              <select id="fType" required>
                <option value="">Choose</option>
                <option>Baby</option>
                <option>Maternity</option>
                <option>Birthday</option>
                <option>Event</option>
                <option>Bridal</option>
                <option>Custom</option>
              </select>
            </div>
            <div class="field">
              <label for="fMembers">Members Attending</label>
              <input type="number" id="fMembers" min="1" placeholder="e.g. 4">
            </div>
          </div>
          <div class="field">
            <label for="fNote">Special Request / Theme Preference</label>
            <textarea id="fNote" rows="2" placeholder="Tell us your idea..."></textarea>
          </div>
          <label class="consent">
            <input type="checkbox" id="fConsent" required>
            I agree to be contacted via WhatsApp/Call regarding my booking
          </label>
          <button type="submit" class="btn btn-gold btn-block" id="submitBtn">
            <span class="btn-label">Send Booking Request</span>
            <span class="spinner"></span>
          </button>
        </form>
      </div>

      <div class="modal-success" id="formSuccess">
        <div class="success-check">✓</div>
        <h3>Request Sent!</h3>
        <p id="successMsg">Thank you! We've received your booking request. Our team at SivaDevi Rental Studio will
          confirm your slot shortly.</p>
        <p class="success-note">For urgent queries, call <a href="tel:+919489354590">94893 54590</a></p>
        <button class="btn btn-outline" id="closeSuccess">Close</button>
      </div>
    </div>
  </div>

  <!-- ================= THEME REQUEST MODAL ================= -->
  <div class="modal-overlay" id="themeOverlay">
    <div class="modal">
      <button class="modal-close" id="themeModalClose" aria-label="Close">&times;</button>

      <div class="modal-form-wrap" id="themeFormWrap">
        <p class="eyebrow">Theme PDF Request</p>
        <h3 id="themeModalTitle">Get This Theme</h3>
        <p class="theme-modal-sub">Share your name &amp; number — we'll WhatsApp you the theme PDF right away.</p>
        <form id="themeForm">
          <div class="field">
            <label for="tName">Full Name *</label>
            <input type="text" id="tName" required placeholder="e.g. Priya Karthik">
          </div>
          <div class="field">
            <label for="tPhone">WhatsApp Number *</label>
            <input type="tel" id="tPhone" required placeholder="10-digit mobile number" pattern="[0-9]{10}">
          </div>
          <button type="submit" class="btn btn-gold btn-block" id="themeSubmitBtn">
            <span class="btn-label">Send to My WhatsApp</span>
            <span class="spinner"></span>
          </button>
        </form>
      </div>

      <div class="modal-success" id="themeFormSuccess">
        <div class="success-check">✓</div>
        <h3>Request Sent!</h3>
        <p id="themeSuccessMsg">Thank you! Our team will send this theme's PDF to your WhatsApp shortly.</p>
        <p class="success-note">For urgent queries, call <a href="tel:+919489354590">94893 54590</a></p>
        <button class="btn btn-outline" id="themeCloseSuccess">Close</button>
      </div>
    </div>
  </div>

  <!-- ================= GALLERY LIGHTBOX ================= -->
