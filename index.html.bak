        </div>
        <div class="why-item reveal-up"><span>📸</span>
          <p>Skilled, friendly studio staff</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TESTIMONIALS (CAROUSEL) ================= -->
  <section class="section section-alt" id="testimonials">
    <div class="container">
      <p class="eyebrow center">Kind Words</p>
      <h2 class="section-title center">From Families We've Photographed</h2>
      <div class="testi-carousel">
        <button class="testi-nav testi-prev" id="testiPrev" aria-label="Previous testimonial">‹</button>
