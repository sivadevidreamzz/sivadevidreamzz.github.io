<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SivaDevi Rental Studio | Thanjavur's Premium Prop Studio & Event Space</title>
  <meta name="description"
    content="Thanjavur's premium photo prop studio &amp; open-sky event space. 150+ props, 50+ backdrops, baby, maternity, birthday &amp; bridal shoots. Book your slot today.">
  <link rel="icon" href="media/shop/logo-dark.jpeg" type="image/jpeg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Poppins:wght@300;400;500;600;700&family=Noto+Sans+Tamil:wght@400;500&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <!-- ================= PRE-LOADER ================= -->
  <div id="preloader">
    <div class="crest-spin"></div>
    <p>SivaDevi Rental Studio</p>
  </div>

  <!-- ================= AMBIENT GOLD PARTICLES ================= -->
  <canvas id="particles"></canvas>

  <!-- ================= NAV ================= -->
  <header class="nav" id="nav">
    <div class="nav-inner">
      <a href="#home" class="brand">
        <img src="media/shop/logo-dark.jpeg" alt="SivaDevi Rental Studio crest" class="theme-logo" id="navLogo">
        <span class="brand-text">SivaDevi<em>Rental Studio</em></span>
      </a>
      <nav class="nav-links" id="navLinks">
        <a href="#amenities">Amenities</a>
        <a href="#categories">Categories</a>
        <a href="#gallery">Gallery</a>
        <a href="#pricing">Packages</a>
        <a href="#about">About</a>
        <a href="#themes">Themes</a>
        <a href="#faq">FAQ</a>
        <a href="#contact">Contact</a>
        <button class="btn btn-gold nav-book" data-open-booking>Book Your Slot</button>
      </nav>
      <button class="hamburger" id="hamburger" aria-label="Toggle menu"><span></span><span></span><span></span></button>
    </div>
  </header>

  <!-- ================= HERO / CAROUSEL ================= -->
  <section class="hero" id="home">
    <div class="hero-slides">
      <div class="slide is-active" style="background-image:url('media/baby/baby-1.jpeg')"></div>
      <div class="slide" style="background-image:url('media/maternity/maternity-2.jpeg')"></div>
      <div class="slide" style="background-image:url('media/crawelling/crawelling-3.jpeg')"></div>
      <div class="slide" style="background-image:url('media/new-born/new-born-5.jpeg')"></div>
    </div>
    <div class="hero-veil"></div>
    <div class="hero-arch-frame"></div>

    <div class="hero-content reveal-up">
      <p class="eyebrow">Thanjavur · Open-Sky Prop Studio</p>
      <h1 class="hero-title">Where Every Little Moment<br>Becomes a <span>Masterpiece</span></h1>
      <p class="hero-sub">Thanjavur's Premium Prop Studio &amp; Event Space — 150+ Props, 50+ Backdrops, and an Open-Sky
        Venue Made for Unforgettable Frames.</p>
      <p class="hero-tamil">உங்கள் அழகான தருணங்களை கலைப்படைப்புகளாக மாற்றும் ஸ்டூடியோ</p>

      <div class="hero-ctas">
        <button class="btn btn-gold" data-open-booking>Book Your Slot</button>
        <a href="https://wa.me/919489354590?text=Hi%2C%20I%27d%20like%20to%20enquire%20about%20a%20shoot%20at%20SivaDevi%20Rental%20Studio."
          target="_blank" rel="noopener" class="btn btn-outline">Enquire on WhatsApp</a>
      </div>

      <ul class="trust-strip">
        <li>100+ Props</li>
        <li>50+ Backdrops</li>
        <li>Fully A/C</li>
        <li>Open Sky Venue</li>
        <li>Free Parking</li>
      </ul>
    </div>

    <div class="hero-dots">
      <button class="dot is-active" data-slide="0" aria-label="Slide 1"></button>
      <button class="dot" data-slide="1" aria-label="Slide 2"></button>
      <button class="dot" data-slide="2" aria-label="Slide 3"></button>
      <button class="dot" data-slide="3" aria-label="Slide 4"></button>
    </div>
    <a href="#amenities" class="scroll-cue"><span></span>Scroll</a>
  </section>

  <!-- ================= AVAILABILITY STRIP ================= -->
  <div class="availability-strip">
    <div class="availability-track">
      <span>✨ Slots filling fast for this weekend — Baby &amp; Maternity mornings almost booked</span>
      <span>🌤️ Open-Sky evening slots now open for birthdays &amp; engagements</span>
      <span>📍 75 Shanthi Nagar, Yagappa Nagar Road, Thanjavur – 613006</span>
      <span>✨ Slots filling fast for this weekend — Baby &amp; Maternity mornings almost booked</span>
      <span>🌤️ Open-Sky evening slots now open for birthdays &amp; engagements</span>
      <span>📍 75 Shanthi Nagar, Yagappa Nagar Road, Thanjavur – 613006</span>
    </div>
  </div>

  <!-- ================= AMENITIES ================= -->
  <section class="section" id="amenities">
    <div class="container">
      <p class="eyebrow center">What's Included</p>
      <h2 class="section-title center">Amenities &amp; Facilities</h2>
      <div class="amenity-grid">
        <div class="arch-card reveal-up">
          <div class="arch-icon">🏛️</div>
          <h3>Studio Infrastructure</h3>
          <ul>
            <li>Fully air-conditioned studio</li>
            <li>Open-sky venue with festive lighting</li>
            <li>Spacious waiting area</li>
            <li>CCTV coverage for safety</li>
            <li>High-speed Wi-Fi</li>
            <li>RO purified drinking water</li>
          </ul>
        </div>
        <div class="arch-card reveal-up">
          <div class="arch-icon">👗</div>
          <h3>Props &amp; Wardrobe</h3>
          <ul>
            <li>150+ traditional-to-trendy baby props</li>
            <li>Massive maternity prop collection</li>
            <li>Maternity gowns</li>
            <li>Mom &amp; daughter combo gowns</li>
            <li>Age-wise combo sets available</li>
            <li>Moon chair &amp; signature seating props</li>
          </ul>
        </div>
        <div class="arch-card reveal-up">
          <div class="arch-icon">🎨</div>
          <h3>Backdrops &amp; Decor</h3>
          <ul>
            <li>Canvas backdrops — mini to maxi sizes</li>
            <li>Welcome board / name board setup</li>
            <li>Themed &amp; readymade decor options</li>
          </ul>
        </div>
        <div class="arch-card reveal-up">
          <div class="arch-icon">💡</div>
          <h3>Technical &amp; Lighting</h3>
          <ul>
            <li>Professional lighting — SK400, ETC &amp; more</li>
            <li>Powerful studio-grade equipment</li>
          </ul>
        </div>
        <div class="arch-card reveal-up">
          <div class="arch-icon">🧼</div>
          <h3>Comfort &amp; Convenience</h3>
          <ul>
            <li>Dedicated makeup / changing room</li>
            <li>Parenting / feeding room</li>
            <li>Clean washroom facilities</li>
            <li>Hygienic shoot handling</li>
          </ul>
        </div>
        <div class="arch-card reveal-up">
          <div class="arch-icon">🚗</div>
          <h3>Getting Here</h3>
          <ul>
            <li>Free on-site parking</li>
            <li>Near Anna Nagar Bus Stop</li>
            <li>Easy access via Nanjikottai Road</li>
          </ul>
        </div>
      </div>
      <div class="section-cta">
        <p>Have a question about what's included?</p>
        <button class="btn btn-gold" data-open-booking>Ask Us — It's Free</button>
      </div>
    </div>
  </section>

  <!-- ================= CATEGORIES ================= -->
  <section class="section section-alt" id="categories">
    <div class="container">
      <p class="eyebrow center">Browse By Occasion</p>
      <h2 class="section-title center">Props, Themes &amp; Backdrops</h2>
      <div class="cat-grid">
        <div class="cat-card reveal-up" style="--img:url('media/baby/baby-10.jpeg')">
          <div class="cat-img"></div>
          <h3>Baby Props</h3>
          <p>Traditional &amp; trendy sets for newborn to toddler shoots</p>
          <button class="cat-enquire" data-open-booking>Enquire →</button>
        </div>
        <div class="cat-card reveal-up" style="--img:url('media/new-born/new-born-9.jpeg')">
          <div class="cat-img"></div>
          <h3>New Born Specials</h3>
          <p>Soft, dreamy setups for your baby's very first frames</p>
          <button class="cat-enquire" data-open-booking>Enquire →</button>
        </div>
        <div class="cat-card reveal-up" style="--img:url('media/crawelling/crawelling-8.jpeg')">
          <div class="cat-img"></div>
          <h3>Crawling &amp; Milestone</h3>
          <p>Playful props to capture your little one on the move</p>
          <button class="cat-enquire" data-open-booking>Enquire →</button>
        </div>
        <div class="cat-card reveal-up" style="--img:url('media/maternity/maternity-5.jpeg')">
          <div class="cat-img"></div>
          <h3>Maternity Collection</h3>
          <p>Elegant gowns, drapes &amp; massive prop setups</p>
          <button class="cat-enquire" data-open-booking>Enquire →</button>
        </div>
        <div class="cat-card reveal-up" style="--img:url('media/family/family-1.jpeg')">
          <div class="cat-img"></div>
          <h3>Family Portraits</h3>
          <p>Warm, timeless frames with everyone together</p>
          <button class="cat-enquire" data-open-booking>Enquire →</button>
        </div>
        <div class="cat-card reveal-up" style="--img:url('media/baby/baby-11.jpeg')">
          <div class="cat-img"></div>
          <h3>Readymade Themes</h3>
          <p>Pre-styled sets ready to book as-is — see our Themes gallery</p>
          <button class="cat-enquire" data-open-booking>Enquire →</button>
        </div>
        <div class="cat-card reveal-up cat-custom" data-open-booking>
          <div class="cat-img cat-custom-img">✦</div>
          <h3>Custom Theme Request</h3>
          <p>Tell us your vision — we'll build it</p>
          <button class="cat-enquire">Start Now →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= GALLERY ================= -->
  <section class="section" id="gallery">
    <div class="container">
      <p class="eyebrow center">Real Shoots, Real Families</p>
      <h2 class="section-title center">Portfolio Wall</h2>
      <p class="section-sub center">Tap any photo to view it full size</p>
      <div class="filter-tabs">
        <button class="filter-tab is-active" data-filter="all">All</button>
        <button class="filter-tab" data-filter="baby">Baby</button>
        <button class="filter-tab" data-filter="newborn">New Born</button>
        <button class="filter-tab" data-filter="crawling">Crawling</button>
        <button class="filter-tab" data-filter="maternity">Maternity</button>
        <button class="filter-tab" data-filter="family">Family</button>
      </div>
      <div class="masonry" id="masonry">
        <div class="mason-item" data-cat="baby"><img src="media/baby/baby-1.jpeg" alt="Baby prop shoot"></div>
        <div class="mason-item" data-cat="maternity"><img src="media/maternity/maternity-1.jpeg" alt="Maternity shoot">
        </div>
        <div class="mason-item" data-cat="newborn"><img src="media/new-born/new-born-2.jpeg" alt="New born shoot"></div>
        <div class="mason-item" data-cat="crawling"><img src="media/crawelling/crawelling-2.jpeg"
            alt="Crawling milestone shoot"></div>
        <div class="mason-item" data-cat="family"><img src="media/family/family-1.jpeg" alt="Family portrait"></div>
        <div class="mason-item" data-cat="baby"><img src="media/baby/baby-3.jpeg" alt="Baby prop shoot"></div>
        <div class="mason-item" data-cat="maternity"><img src="media/maternity/maternity-3.jpeg" alt="Maternity shoot">
        </div>
        <div class="mason-item" data-cat="newborn"><img src="media/new-born/new-born-10.jpeg" alt="New born shoot">
        </div>
        <div class="mason-item" data-cat="crawling"><img src="media/crawelling/crawelling-16.jpeg"
            alt="Crawling milestone shoot"></div>
        <div class="mason-item" data-cat="baby"><img src="media/baby/baby-12.jpeg" alt="Baby prop shoot"></div>
        <div class="mason-item" data-cat="maternity"><img src="media/maternity/maternity-7.jpeg" alt="Maternity shoot">
        </div>
        <div class="mason-item" data-cat="crawling"><img src="media/crawelling/crawelling-3.jpeg"
            alt="Crawling milestone shoot"></div>
        <div class="mason-item" data-cat="baby"><img src="media/baby/baby-13.jpeg" alt="Baby prop shoot"></div>
        <div class="mason-item" data-cat="newborn"><img src="media/new-born/new-born-9.jpeg" alt="New born shoot"></div>
      </div>
      <div class="section-cta">
        <button class="btn btn-gold" data-open-booking>Book Your Shoot Like These</button>
      </div>
    </div>
  </section>

  <!-- ================= PRICING ================= -->
  <section class="section section-alt" id="pricing">
    <div class="container">
      <p class="eyebrow center">Packages</p>
      <h2 class="section-title center">Simple, Transparent Starting Prices</h2>
      <div class="pricing-grid">
        <div class="price-card reveal-up">
          <h3>Baby &amp; Toddler</h3>
          <p class="price">Starting from ₹2,499</p>
          <ul>
            <li>1 hour studio slot</li>
            <li>Up to 3 prop changes</li>
            <li>Makeup room access</li>
          </ul>
          <button class="btn btn-outline" data-open-booking>Enquire</button>
        </div>
        <div class="price-card is-featured reveal-up">
          <span class="price-tag">Most Booked</span>
          <h3>Maternity</h3>
          <p class="price">Starting from ₹3,999</p>
          <ul>
            <li>1.5 hour studio slot</li>
            <li>Maternity gowns included</li>
            <li>Partner &amp; family frames</li>
          </ul>
          <button class="btn btn-gold" data-open-booking>Enquire</button>
        </div>
        <div class="price-card reveal-up">
          <h3>Birthday &amp; Events</h3>
          <p class="price">Starting from ₹5,999</p>
          <ul>
            <li>Open-sky venue access</li>
            <li>Full decor &amp; backdrop setup</li>
            <li>Evening / night slots</li>
          </ul>
          <button class="btn btn-outline" data-open-booking>Enquire</button>
        </div>
      </div>
      <div class="price-note">
        <span class="price-note-icon">💬</span>
        <p><strong>Custom &amp; combo pricing available.</strong> WhatsApp or call us for a detailed quote tailored to
          your shoot.</p>
        <a href="https://wa.me/919489354590?text=Hi%2C%20I%27d%20like%20a%20custom%20price%20quote." target="_blank"
          rel="noopener" class="btn btn-gold">Get a Quote on WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- ================= ABOUT ================= -->
  <section class="section" id="about">
    <div class="container about-grid">
      <div class="about-media reveal-up">
        <img src="media/shop/shop_out_look.jpeg" alt="Inside SivaDevi Rental Studio">
        <div class="about-badge">
          <strong>15+</strong>
          <span>Years of family trust</span>
        </div>
      </div>
      <div class="about-copy reveal-up">
        <p class="eyebrow">The Studio Behind Your Story</p>
        <h2 class="section-title">A partner in capturing your family's most precious chapters</h2>
        <p>SivaDevi Rental Studio is Thanjavur's leading photo and event prop studio, located at 75 Shanthi Nagar, Anna
          Nagar Bus Stop (Nanjikottai Road), Yagappa Nagar Road, Thanjavur – 613006.</p>
        <p>Spread across a spacious, fully air-conditioned space with an open-sky venue, we bring together 100+ curated
          props and 50+ handcrafted backdrops to help you create photographs that feel timeless — from traditional to
          trendy baby shoots, massive maternity setups, to full-scale birthday and celebration decor.</p>
        <p>Our in-house makeup and feeding rooms, mineral RO water, and hygienic shoot-handling practices ensure your
          family's comfort throughout the session.</p>
        <p class="quote">"Turning your moments into masterpieces — one frame at a time."</p>
        <button class="btn btn-gold" data-open-booking>Plan My Visit</button>
      </div>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <section class="stats-band">
    <div class="container stats-grid">
      <div class="stat"><span class="stat-num" data-count="150">0</span><small>Curated Props</small></div>
      <div class="stat"><span class="stat-num" data-count="50">0</span><small>Handcrafted Backdrops</small></div>
      <div class="stat"><span class="stat-num" data-count="15">0</span><small>Years Serving Thanjavur</small></div>
      <div class="stat"><span class="stat-num" data-count="4000">0</span><small>Families Photographed</small></div>
    </div>
  </section>

  <!-- ================= WHY CHOOSE US ================= -->
  <section class="section" id="why">
    <div class="container">
      <p class="eyebrow center">Why Families Choose Us</p>
      <h2 class="section-title center">Built For Comfort, Made For Memories</h2>
      <div class="why-grid">
        <div class="why-item reveal-up"><span>🏆</span>
          <p>100+ props, 50+ backdrops — one of Thanjavur's largest collections</p>
